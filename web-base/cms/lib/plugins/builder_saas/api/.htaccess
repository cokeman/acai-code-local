
DirectoryIndex index.php

Order Deny,Allow
Allow from all

<IfModule mod_rewrite.c>

	RewriteEngine on

	RewriteCond %{REQUEST_METHOD} OPTIONS
	RewriteRule ^(.*)$ $1 [R=200,L]
		
	RewriteRule ^v1/dummy/?$ index.php?isQuery=1&tableName=dummy [QSA,NC,L]
	RewriteRule ^v1/([a-zA-Z_0-9]+)/?$ index.php?tableName=$1 [QSA,NC,L]
	RewriteRule ^v1/([a-zA-Z_0-9]+)/([0-9]+)/?$ index.php?tableName=$1&num=$2 [QSA,NC,L]
	RewriteRule ^v1/(.*)$ index.php [QSA,NC,L]

</IfModule>