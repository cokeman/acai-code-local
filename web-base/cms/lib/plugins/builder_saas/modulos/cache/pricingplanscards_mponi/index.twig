<section class="pricing-plans-cards py-16 lg:py-24 bg-gray-50">
  <div class="pricing-plans-cards__container max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="pricing-plans-cards__header text-center mb-12">
      <span class="pricing-plans-cards__badge inline-block text-blue-600 font-semibold text-sm uppercase tracking-wider mb-4">
                        {% if badge %} 
 
                            {{ badge | raw }} 
 
                        {% else %} 
 
                            {{ "Pricing Plans" | raw }} 
 
                        {% endif %}
                    </span>
      <h2 class="pricing-plans-cards__title text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
        <span>
                        {% if tituloparte1 %} 
 
                            {{ tituloparte1 | raw }} 
 
                        {% else %} 
 
                            {{ "Our Business Pricing Plan" | raw }} 
 
                        {% endif %}
                    </span>
        <br>
        <span>
                        {% if tituloparte2 %} 
 
                            {{ tituloparte2 | raw }} 
 
                        {% else %} 
 
                            {{ "You Might Like" | raw }} 
 
                        {% endif %}
                    </span>
      </h2>
    </div>
    
    <!-- Pricing Grid -->
    <div class="pricing-plans-cards__grid grid md:grid-cols-3 gap-8">
      <ul class="contents">
        
{% for record in planes %} {% set index = loop.index0 %}
<li class="pricing-plans-cards__card bg-white rounded-3xl p-8 shadow-sm hover:shadow-xl transition-shadow relative">
          <!-- Popular badge (conditional) -->
          
{% if destacado = 'Si' %}
<div class="pricing-plans-cards__popular absolute -top-4 left-1/2 -translate-x-1/2 bg-blue-600 text-white text-sm font-medium px-4 py-1 rounded-full">
            Popular
          </div>
{% endif %}

          
 
                        {% set list_values = record.destacado | trim | split("	") %} 

                    
 
                        {% if record %} 
 
                            {% set auxRecord = record %} 
 
                        {% endif %} 

                    
 
                        
                        {% for record in list_values %} 
 
                            {% set index = loop.index0 %} 
 
                    

                        {% endfor %}

                        {% if auxRecord %} {% set record = auxRecord %} {% endif %}
                    
          
          <!-- Plan name -->
          <h3 class="pricing-plans-cards__plan-name text-xl font-bold text-gray-900 mb-2">
                        {% if record.nombreplan %} 
 
                            {{ record.nombreplan | raw }} 
 
                        {% else %} 
 
                            {{ "Basic" | raw }} 
 
                        {% endif %}
                    </h3>
          
          <!-- Price -->
          <div class="pricing-plans-cards__price flex items-baseline gap-1 mb-6">
            <span class="text-4xl font-bold text-gray-900">
                        {% if record.precio %} 
 
                            {{ record.precio | raw }} 
 
                        {% else %} 
 
                            {{ "$19" | raw }} 
 
                        {% endif %}
                    </span>
            <span class="text-gray-500">
                        {% if record.periodo %} 
 
                            {{ record.periodo | raw }} 
 
                        {% else %} 
 
                            {{ "/mo" | raw }} 
 
                        {% endif %}
                    </span>
          </div>
          
          <!-- CTA Button -->
          <a href="{{ record.botonlink }}" class="pricing-plans-cards__btn block w-full text-center py-3 px-6 rounded-full font-medium transition-colors mb-8 border-2 border-blue-600 text-blue-600 hover:bg-blue-600 hover:text-white"><span><? echo @record["botontexto"] ? nl2br(record["botontexto"]) : 'Get Started';?></span>
          </a>
          
          <!-- Features -->
          <ul class="pricing-plans-cards__features space-y-3">
            
{% for record in record.caracteristicasplan %} {% set index = loop.index0 %}
<li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-blue-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
              <span class="text-gray-600">
                        {% if record.caracteristica %} 
 
                            {{ record.caracteristica | raw }} 
 
                        {% else %} 
 
                            {{ "Backup App development" | raw }} 
 
                        {% endif %}
                    </span>
            </li>
{% endfor %}

          </ul>
        </li>
{% endfor %}

      </ul>
    </div>
  </div>
</section>