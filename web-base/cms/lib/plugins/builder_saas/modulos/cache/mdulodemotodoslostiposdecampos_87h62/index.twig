<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold mb-8 text-center">Módulo Demo - Todos los Tipos de Campos</h1>
  
  <!-- Textfield -->
  <section class="mb-8 p-6 bg-gray-50 rounded-lg">
    <h2 class="text-xl font-semibold mb-4">1. Textfield (Campo de Texto Simple)</h2>
    <p class="text-lg">
                        {% if campodetextosimple %} 
 
                            {{ campodetextosimple | raw }} 
 
                        {% else %} 
 
                            {{ "Texto editable simple" | raw }} 
 
                        {% endif %}
                    </p>
  </section>

  <!-- Headfield -->
  <section class="mb-8 p-6 bg-gray-50 rounded-lg">
    <h2 class="text-xl font-semibold mb-4">2. Headfield (Campo de Título)</h2>
    
                            {% set ttuloprincipal_tag = ttuloprincipal_tag ?: 'P' %}
                            {{ ('<' ~ ttuloprincipal_tag ~ ' class="text-2xl font-bold" >' ~ (ttuloprincipal ? ttuloprincipal : 'Título editable') ~ ('PC8=' | base64_decode) ~ ttuloprincipal_tag ~ '>') | raw }}
                        
  </section>

  <!-- Textbox -->
  <section class="mb-8 p-6 bg-gray-50 rounded-lg">
    <h2 class="text-xl font-semibold mb-4">3. Textbox (Campo de Texto Largo)</h2>
    <div class="text-gray-700">
                        {% if descripcinlarga %} 
 
                            {% if descripcinlarga | isHTML %}
                                {{ descripcinlarga | raw }} 
 
                            {% else %}
                                {{ descripcinlarga | nl2br }} 
 
                            {% endif %}
                        {% else %} 
 
                            {{ "
      Este es un campo de texto largo donde puedes escribir párrafos completos. El cliente puede editar este contenido desde el editor.
    " | nl2br }} 
 
                        {% endif %}
                    </div>
  </section>

  <!-- WYSIWYG -->
  <section class="mb-8 p-6 bg-gray-50 rounded-lg">
    <h2 class="text-xl font-semibold mb-4">4. WYSIWYG (Editor de Texto Enriquecido)</h2>
    <div class="wysiwyg">
                        {% if contenidoenriquecido %} 
 
                            {{ contenidoenriquecido | raw }} 
 
                        {% else %} 
 
                            {{ "
      <p>Este es un editor de texto enriquecido donde puedes <strong>formatear</strong> el texto, agregar <em>énfasis</em>, listas y más.</p>
      <ul>
        <li>Elemento de lista 1</li>
        <li>Elemento de lista 2</li>
      </ul>
    " | raw }} 
 
                        {% endif %}
                    </div>
  </section>

  <!-- Link -->
  <section class="mb-8 p-6 bg-gray-50 rounded-lg">
    <h2 class="text-xl font-semibold mb-4">5. Link (Enlace)</h2>
    <a href="{{ enlaceprincipal }}" class="text-blue-600 hover:underline">{{ enlaceprincipal_anchor }}</a>
  </section>

  <!-- List (Opciones de Texto) -->
  <section class="mb-8 p-6 bg-gray-50 rounded-lg">
    <h2 class="text-xl font-semibold mb-4">6. List - Opciones de Texto</h2>
    
 
                        {% set list_values = seleccinsimple | trim | split("	") %} 

                    
 
                        {% if record %} 
 
                            {% set auxRecord = record %} 
 
                        {% endif %} 

                    
 
                        
                        {% for record in list_values %} 
 
                            {% set index = loop.index0 %} 
 
                    <div class="text-lg">
      Selecciona una opción
    </div>

                        {% endfor %}

                        {% if auxRecord %} {% set record = auxRecord %} {% endif %}
                    
  </section>

  <!-- Upload (Imagen) -->
  <section class="mb-8 p-6 bg-gray-50 rounded-lg">
    <h2 class="text-xl font-semibold mb-4">7. Upload (Imagen)</h2>
    <div class="p-1/6 relative mb-4">
      <img data-src="{{ imagenprincipal.0.urlPath | imagec(1400) }}" alt="Imagen editable" class="w-full h-auto rounded-lg lazyload">
    </div>
  </section>

  <!-- Multi (Elementos Múltiples) -->
  <section class="mb-8 p-6 bg-gray-50 rounded-lg">
    <h2 class="text-xl font-semibold mb-4">8. Multi (Elementos Múltiples)</h2>
    <ul class="space-y-4">
      
{% for record in elementosmltiples %} {% set index = loop.index0 %}
<li class="p-4 bg-white rounded border">
        <div class="mb-2">
          <strong class="text-lg">
                        {% if record.ttulodelelemento %} 
 
                            {{ record.ttulodelelemento | raw }} 
 
                        {% else %} 
 
                            {{ "Título del elemento" | raw }} 
 
                        {% endif %}
                    </strong>
        </div>
        <div class="mb-2">
          <p class="text-gray-600">
                        {% if record.descripcindelelemento %} 
 
                            {% if record.descripcindelelemento | isHTML %}
                                {{ record.descripcindelelemento | raw }} 
 
                            {% else %}
                                {{ record.descripcindelelemento | nl2br }} 
 
                            {% endif %}
                        {% else %} 
 
                            {{ "Descripción del elemento múltiple" | nl2br }} 
 
                        {% endif %}
                    </p>
        </div>
        <div class="mb-2 p-1/6 relative">
          <img data-src="{{ record.imagendelelemento.0.urlPath | imagec(800) }}" alt="Imagen del elemento" class="w-full h-auto rounded lazyload">
        </div>
        <div class="mt-2">
          <a href="{{ record.enlacedelelemento }}" class="text-blue-600 hover:underline">{{ record.enlacedelelemento_anchor }}</a>
        </div>
      </li>
{% endfor %}

    </ul>
  </section>

  <!-- List (Tabla) - Ejemplo si hay tablas disponibles -->
  <section class="mb-8 p-6 bg-gray-50 rounded-lg">
    <h2 class="text-xl font-semibold mb-4">9. List - Desde Tabla (si hay tablas disponibles)</h2>
    
 
                        {% set list_values = seleccindesdetabla | trim | split("	") %} 

                    
 
                        {% if record %} 
 
                            {% set auxRecord = record %} 
 
                        {% endif %} 

                    
 
                        
                        {% for record in list_values %} 
 
                            {% set index = loop.index0 %} 
 
                    

                            {% if 'noticias' | loadSchema %} 
 
                                {% set record = 'noticias' | get([{'column':'num','operator':'=','value':record}]) %} 
 
                                {% set record = record.0 %} 

                            {% else %} 
 
                                {% set record = 'cms_noticias' | get([{'column':'num','operator':'=','value':record}],'num desc',1,{'ignoreSchema':true}) %} 
                                {% set record = record.0 %} 
                            {% endif %}
                        <div class="text-lg">
      Selecciona un elemento de la tabla
    </div>

                        {% endfor %}

                        {% if auxRecord %} {% set record = auxRecord %} {% endif %}
                    
  </section>

  <!-- Combinación de Campos -->
  <section class="mb-8 p-6 bg-blue-50 rounded-lg border-2 border-blue-200">
    <h2 class="text-xl font-semibold mb-4">10. Sección Combinada (Múltiples Campos)</h2>
    <div class="space-y-4">
      
                            {% set ttulodeseccin_tag = ttulodeseccin_tag ?: 'P' %}
                            {{ ('<' ~ ttulodeseccin_tag ~ ' class="text-2xl font-bold" >' ~ (ttulodeseccin ? ttulodeseccin : 'Título de la sección') ~ ('PC8=' | base64_decode) ~ ttulodeseccin_tag ~ '>') | raw }}
                        
      <p class="text-lg text-gray-600">
                        {% if subttulo %} 
 
                            {{ subttulo | raw }} 
 
                        {% else %} 
 
                            {{ "Subtítulo editable" | raw }} 
 
                        {% endif %}
                    </p>
      <div class="text-gray-700">
                        {% if contenido %} 
 
                            {% if contenido | isHTML %}
                                {{ contenido | raw }} 
 
                            {% else %}
                                {{ contenido | nl2br }} 
 
                            {% endif %}
                        {% else %} 
 
                            {{ "
        Contenido largo de la sección combinada.
      " | nl2br }} 
 
                        {% endif %}
                    </div>
      <div class="p-1/6 relative">
        <img data-src="{{ imagendeseccin.0.urlPath | imagec(1200) }}" alt="Imagen de sección" class="w-full h-auto rounded-lg lazyload">
      </div>
      <a href="{{ enlacedeseccin }}" class="inline-block px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">{{ enlacedeseccin_anchor }}</a>
    </div>
  </section>

  <!-- Ejemplo con Condicionales -->
  <section class="mb-8 p-6 bg-green-50 rounded-lg">
    <h2 class="text-xl font-semibold mb-4">11. Campos con Condicionales (c-if)</h2>
    <div class="mb-4">
                        {% if mostrarcontenidoextra %} 
 
                            {{ mostrarcontenidoextra | raw }} 
 
                        {% else %} 
 
                            {{ "
      <input type="\&quot;checkbox\&quot;" id="\&quot;mostrarExtra\&quot;"> Mostrar contenido extra
    " | raw }} 
 
                        {% endif %}
                    </div>
    
{% if mostrarcontenidoextra %}
<div class="p-4 bg-white rounded">
      <p>
                        {% if contenidocondicional %} 
 
                            {{ contenidocondicional | raw }} 
 
                        {% else %} 
 
                            {{ "Este contenido solo se muestra si el checkbox está activado" | raw }} 
 
                        {% endif %}
                    </p>
    </div>
{% endif %}

  </section>
</div>