<div class="mb-20">
	<div class="container sm:mx-auto ">
	    <div class="relative">
			<span class="mt-8 lg:mt-20 block text-teal-400 text-3xl font-thin text-center relative z-10">Noticias</span>
			<p class="text-gray-500 text-center"><i class="fa fa-calendar"></i> {{thisrecord.fecha | getDate('d-m-Y')}}</p>
		    <h1 class="block text-center text-2xl lg:text-4xl text-gray-600 font-light relative z-10">{{thisrecord.title}}</h1>
		</div>
	</div>
	<div class="relative">
	    <img src="https://www.plandeweb.com/maquetas/maqueta-impulso/images/banda2.svg" class="inverted absolute top-0 left-0 w-full h-full object-cover object-center z-0 ">
	    <div class="container sm:mx-auto px-4 block pb-12 relative z-10 max-w-4xl">
			<img v-if="thisrecord.foto_principal" src="{{thisrecord.foto_principal[0].urlPath | imagec(1000)}}" class="bg-white w-full my-8 p-2 border rounded-sm shadow-md relative z-10" alt="{{thisrecord.title}}">
		</div>
	</div>
	<div class="container sm:mx-auto px-4 block relative z-10 max-w-4xl">
		<div class="relative">
			<p class="mb-8 italic text-teal-500 text-xl">{{thisrecord.subtitulo}}</p>
			<div class="text-gray-600 text-xl my-8">{{thisrecord.content}}</div>
		</div>
	</div> 
</div> 