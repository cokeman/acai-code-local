<div class="\&quot;formulario-presupuesto-marketing\&quot;">
  <!-- Indicador de progreso -->
  <div class="\&quot;formulario-presupuesto-marketing__progress\&quot;">
    <div class="\&quot;formulario-presupuesto-marketing__progress-steps\&quot;">
      <div class="\&quot;formulario-presupuesto-marketing__step\&quot;" :class="\&quot;{" 'formulario-presupuesto-marketing__step--active':="" pasoactual="==" 1,="" 'formulario-presupuesto-marketing__step--completed':=""> 1 }\">
        <span class="\&quot;formulario-presupuesto-marketing__step-number\&quot;">1</span>
        <span class="\&quot;formulario-presupuesto-marketing__step-label\&quot;">Tu Información</span>
      </div>
      <div class="\&quot;formulario-presupuesto-marketing__step\&quot;" :class="\&quot;{" 'formulario-presupuesto-marketing__step--active':="" pasoactual="==" 2,="" 'formulario-presupuesto-marketing__step--completed':=""> 2 }\">
        <span class="\&quot;formulario-presupuesto-marketing__step-number\&quot;">2</span>
        <span class="\&quot;formulario-presupuesto-marketing__step-label\&quot;">Tu Proyecto</span>
      </div>
      <div class="\&quot;formulario-presupuesto-marketing__step\&quot;" :class="\&quot;{" 'formulario-presupuesto-marketing__step--active':="" pasoactual="==" 3="" }\"="">
        <span class="\&quot;formulario-presupuesto-marketing__step-number\&quot;">3</span>
        <span class="\&quot;formulario-presupuesto-marketing__step-label\&quot;">Confirmación</span>
      </div>
    </div>
    <div class="\&quot;formulario-presupuesto-marketing__progress-bar\&quot;">
      <div class="\&quot;formulario-presupuesto-marketing__progress-fill\&quot;" :style="\&quot;{" width:="" (pasoactual="" 3)="" *="" 100="" +="" '%'="" }\"=""></div>
    </div>
  </div>

  <!-- Formulario -->
  <form @submit.prevent="\&quot;enviarFormulario\&quot;" class="\&quot;formulario-presupuesto-marketing__form\&quot;">
    <!-- PASO 1: Tu Información -->
    <div v-if="\&quot;pasoActual" =="=" 1\"="" class="\&quot;formulario-presupuesto-marketing__step-content\&quot;">
      <h2 class="\&quot;formulario-presupuesto-marketing__title\&quot;">Cuéntanos sobre ti</h2>
      
      <div class="\&quot;formulario-presupuesto-marketing__field\&quot;">
        <label for="\&quot;nombre\&quot;" class="\&quot;formulario-presupuesto-marketing__label\&quot;">Nombre *</label>
        <input v-model="\&quot;formulario.nombre\&quot;" type="\&quot;text\&quot;" id="\&quot;nombre\&quot;" class="\&quot;formulario-presupuesto-marketing__input\&quot;" placeholder="\&quot;Tu" nombre="" completo\"="" required="">
        <span v-if="\&quot;errores.nombre\&quot;" class="\&quot;formulario-presupuesto-marketing__error\&quot;">{{ errores.nombre }}</span>
      </div>

      <div class="\&quot;formulario-presupuesto-marketing__field\&quot;">
        <label for="\&quot;apellidos\&quot;" class="\&quot;formulario-presupuesto-marketing__label\&quot;">Apellidos *</label>
        <input v-model="\&quot;formulario.apellidos\&quot;" type="\&quot;text\&quot;" id="\&quot;apellidos\&quot;" class="\&quot;formulario-presupuesto-marketing__input\&quot;" placeholder="\&quot;Tus" apellidos\"="" required="">
        <span v-if="\&quot;errores.apellidos\&quot;" class="\&quot;formulario-presupuesto-marketing__error\&quot;">{{ errores.apellidos }}</span>
      </div>

      <div class="\&quot;formulario-presupuesto-marketing__field\&quot;">
        <label for="\&quot;email\&quot;" class="\&quot;formulario-presupuesto-marketing__label\&quot;">Email *</label>
        <input v-model="\&quot;formulario.email\&quot;" type="\&quot;email\&quot;" id="\&quot;email\&quot;" class="\&quot;formulario-presupuesto-marketing__input\&quot;" placeholder="\&quot;tu@email.com\&quot;" required="">
        <span v-if="\&quot;errores.email\&quot;" class="\&quot;formulario-presupuesto-marketing__error\&quot;">{{ errores.email }}</span>
      </div>

      <div class="\&quot;formulario-presupuesto-marketing__field\&quot;">
        <label for="\&quot;telefono\&quot;" class="\&quot;formulario-presupuesto-marketing__label\&quot;">Teléfono *</label>
        <input v-model="\&quot;formulario.telefono\&quot;" type="\&quot;tel\&quot;" id="\&quot;telefono\&quot;" class="\&quot;formulario-presupuesto-marketing__input\&quot;" placeholder="\&quot;+34" 123="" 456="" 789\"="" required="">
        <span v-if="\&quot;errores.telefono\&quot;" class="\&quot;formulario-presupuesto-marketing__error\&quot;">{{ errores.telefono }}</span>
      </div>

      <div class="\&quot;formulario-presupuesto-marketing__field\&quot;">
        <label for="\&quot;empresa\&quot;" class="\&quot;formulario-presupuesto-marketing__label\&quot;">Nombre de la Empresa</label>
        <input v-model="\&quot;formulario.empresa\&quot;" type="\&quot;text\&quot;" id="\&quot;empresa\&quot;" class="\&quot;formulario-presupuesto-marketing__input\&quot;" placeholder="\&quot;Nombre" de="" tu="" empresa="" (opcional)\"="">
      </div>
    </div>

    <!-- PASO 2: Tu Proyecto -->
    <div v-if="\&quot;pasoActual" =="=" 2\"="" class="\&quot;formulario-presupuesto-marketing__step-content\&quot;">
      <h2 class="\&quot;formulario-presupuesto-marketing__title\&quot;">Cuéntanos sobre tu proyecto</h2>
      
      <div class="\&quot;formulario-presupuesto-marketing__field\&quot;">
        <label for="\&quot;industria\&quot;" class="\&quot;formulario-presupuesto-marketing__label\&quot;">Industria/Sector *</label>
        <input v-model="\&quot;formulario.industria\&quot;" type="\&quot;text\&quot;" id="\&quot;industria\&quot;" class="\&quot;formulario-presupuesto-marketing__input\&quot;" placeholder="\&quot;Ej:" e-commerce,="" saas,="" consultoría\"="" required="">
        <span v-if="\&quot;errores.industria\&quot;" class="\&quot;formulario-presupuesto-marketing__error\&quot;">{{ errores.industria }}</span>
      </div>

      <div class="\&quot;formulario-presupuesto-marketing__field\&quot;">
        <label for="\&quot;tiposervicio\&quot;" class="\&quot;formulario-presupuesto-marketing__label\&quot;">Tipo de Servicio *</label>
        <select v-model="\&quot;formulario.tiposervicio\&quot;" id="\&quot;tiposervicio\&quot;" class="\&quot;formulario-presupuesto-marketing__input\&quot;" required="">
          <option value="\&quot;\&quot;">-- Selecciona un servicio --</option>
          <option value="\&quot;redes_sociales\&quot;">Gestión de Redes Sociales</option>
          <option value="\&quot;marketing_digital\&quot;">Marketing Digital</option>
          <option value="\&quot;seo\&quot;">SEO</option>
          <option value="\&quot;publicidad\&quot;">Publicidad Online</option>
          <option value="\&quot;branding\&quot;">Branding</option>
          <option value="\&quot;contenidos\&quot;">Creación de Contenidos</option>
          <option value="\&quot;other\&quot;">Otro</option>
        </select>
        <span v-if="\&quot;errores.tiposervicio\&quot;" class="\&quot;formulario-presupuesto-marketing__error\&quot;">{{ errores.tiposervicio }}</span>
      </div>

      <div class="\&quot;formulario-presupuesto-marketing__field\&quot;">
        <label for="\&quot;descripcionproyecto\&quot;" class="\&quot;formulario-presupuesto-marketing__label\&quot;">Descripción del Proyecto *</label>
        <textarea v-model="\&quot;formulario.descripcionproyecto\&quot;" id="\&quot;descripcionproyecto\&quot;" class="\&quot;formulario-presupuesto-marketing__textarea\&quot;" placeholder="\&quot;Cuéntanos" con="" detalle="" qué="" necesitas...\"="" rows="\&quot;5\&quot;" required=""></textarea>
        <span v-if="\&quot;errores.descripcionproyecto\&quot;" class="\&quot;formulario-presupuesto-marketing__error\&quot;">{{ errores.descripcionproyecto }}</span>
      </div>

      <div class="\&quot;formulario-presupuesto-marketing__field\&quot;">
        <label for="\&quot;presupuestoestimado\&quot;" class="\&quot;formulario-presupuesto-marketing__label\&quot;">Presupuesto Estimado *</label>
        <select v-model="\&quot;formulario.presupuestoestimado\&quot;" id="\&quot;presupuestoestimado\&quot;" class="\&quot;formulario-presupuesto-marketing__input\&quot;" required="">
          <option value="\&quot;\&quot;">-- Selecciona un rango --</option>
          <option value="\&quot;500-1000\&quot;">500€ - 1.000€</option>
          <option value="\&quot;1000-5000\&quot;">1.000€ - 5.000€</option>
          <option value="\&quot;5000-10000\&quot;">5.000€ - 10.000€</option>
          <option value="\&quot;10000-25000\&quot;">10.000€ - 25.000€</option>
          <option value="\&quot;25000+\&quot;">25.000€+</option>
        </select>
        <span v-if="\&quot;errores.presupuestoestimado\&quot;" class="\&quot;formulario-presupuesto-marketing__error\&quot;">{{ errores.presupuestoestimado }}</span>
      </div>
    </div>

    <!-- PASO 3: Confirmación -->
    <div v-if="\&quot;pasoActual" =="=" 3\"="" class="\&quot;formulario-presupuesto-marketing__step-content\&quot;">
      <h2 class="\&quot;formulario-presupuesto-marketing__title\&quot;">Revisa tu solicitud</h2>
      
      <div class="\&quot;formulario-presupuesto-marketing__resumen\&quot;">
        <div class="\&quot;formulario-presupuesto-marketing__resumen-section\&quot;">
          <h3 class="\&quot;formulario-presupuesto-marketing__resumen-title\&quot;">Tu Información</h3>
          <p><strong>Nombre:</strong> {{ formulario.nombre }} {{ formulario.apellidos }}</p>
          <p><strong>Email:</strong> {{ formulario.email }}</p>
          <p><strong>Teléfono:</strong> {{ formulario.telefono }}</p>
          <p v-if="\&quot;formulario.empresa\&quot;"><strong>Empresa:</strong> {{ formulario.empresa }}</p>
        </div>

        <div class="\&quot;formulario-presupuesto-marketing__resumen-section\&quot;">
          <h3 class="\&quot;formulario-presupuesto-marketing__resumen-title\&quot;">Tu Proyecto</h3>
          <p><strong>Sector:</strong> {{ formulario.industria }}</p>
          <p><strong>Servicio:</strong> {{ obtenerEtiquetaServicio() }}</p>
          <p><strong>Presupuesto:</strong> {{ formulario.presupuestoestimado }}</p>
          <p><strong>Descripción:</strong></p>
          <p class="\&quot;formulario-presupuesto-marketing__resumen-text\&quot;">{{ formulario.descripcionproyecto }}</p>
        </div>
      </div>

      <div class="\&quot;formulario-presupuesto-marketing__field\&quot;">
        <label class="\&quot;formulario-presupuesto-marketing__checkbox\&quot;">
          <input v-model="\&quot;formulario.newsletter\&quot;" type="\&quot;checkbox\&quot;" class="\&quot;formulario-presupuesto-marketing__checkbox-input\&quot;">
          <span>Deseo recibir información sobre nuevos servicios y ofertas</span>
        </label>
      </div>

      <div class="\&quot;formulario-presupuesto-marketing__info-note\&quot;">
        <p>Nos pondremos en contacto contigo en breve para discutir tu proyecto y elaborar un presupuesto personalizado.</p>
      </div>
    </div>

    <!-- Botones de navegación -->
    <div class="\&quot;formulario-presupuesto-marketing__buttons\&quot;">
      <button v-if="\&quot;pasoActual"> 1\" 
        type=\"button\" 
        @click=\"pasoActual--\"
        class=\"formulario-presupuesto-marketing__btn formulario-presupuesto-marketing__btn--secondary\"
      >
        ← Anterior
      </button>
      
      <button v-if="\&quot;pasoActual" <="" 3\"="" type="\&quot;button\&quot;" @click="\&quot;siguientePaso\&quot;" class="\&quot;formulario-presupuesto-marketing__btn" formulario-presupuesto-marketing__btn--primary\"="">
        Siguiente →
      </button>

      <button v-if="\&quot;pasoActual" =="=" 3\"="" type="\&quot;submit\&quot;" :disabled="\&quot;enviando\&quot;" class="\&quot;formulario-presupuesto-marketing__btn" formulario-presupuesto-marketing__btn--success\"="">
        {{ enviando ? 'Enviando...' : 'Enviar Solicitud' }}
      </button>
    </div>

    <div v-if="\&quot;mensajeExito\&quot;" class="\&quot;formulario-presupuesto-marketing__success\&quot;">
      <p>✓ {{ mensajeExito }}</p>
    </div>
  </form>
</div>