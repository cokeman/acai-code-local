<section class="landing-contacto bg-slate-50 py-12 sm:py-16">
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-6 lg:grid-cols-2">
    <div class="space-y-4">
      <p class="text-sm font-semibold uppercase tracking-[0.14em] text-amber-500">
                        {% if etiquetasuperior %} 
 
                            {{ etiquetasuperior | raw }} 
 
                        {% else %} 
 
                            {{ "Contacto" | raw }} 
 
                        {% endif %}
                    </p>
      
                            {% set titulo_tag = titulo_tag ?: 'P' %}
                            {{ ('<' ~ titulo_tag ~ ' class="text-3xl font-semibold text-slate-900 sm:text-4xl" >' ~ (titulo ? titulo : 'Hablemos de tu proyecto') ~ ('PC8=' | base64_decode) ~ titulo_tag ~ '>') | raw }}
                        
      <p class="text-base text-slate-600">
                        {% if descripcion %} 
 
                            {% if descripcion | isHTML %}
                                {{ descripcion | raw }} 
 
                            {% else %}
                                {{ descripcion | nl2br }} 
 
                            {% endif %}
                        {% else %} 
 
                            {{ "Envíanos tus datos y un asesor te contactará en menos de 24h." | nl2br }} 
 
                        {% endif %}
                    </p>
      <div class="aspect-[4/3] overflow-hidden rounded-3xl shadow-lg">
        <img src="{{ imagenlateral.0.urlPath | imagec(1400) }}" alt="" class="h-full w-full object-cover">
      </div>
    </div>

    <div class="rounded-3xl bg-white p-6 shadow-xl">
      <form class="space-y-4">
                        {% if formulariohtml %} 
 
                            {% if formulariohtml | isHTML %}
                                {{ formulariohtml | raw }} 
 
                            {% else %}
                                {{ formulariohtml | nl2br }} 
 
                            {% endif %}
                        {% else %} 
 
                            {{ "
        <div class="\&quot;grid" gap-3="" sm:grid-cols-2\"="">
          <div>
            <label class="\&quot;text-sm" font-semibold="" text-slate-700\"="">Nombre</label>
            <input class="\&quot;mt-1" w-full="" rounded-lg="" border="" border-slate-200="" px-3="" py-2="" text-sm="" outline-none="" focus:border-amber-400\"="" type="\&quot;text\&quot;" name="\&quot;nombre\&quot;" placeholder="\&quot;Tu" nombre\"="" required="\&quot;\&quot;">
          </div>
          <div>
            <label class="\&quot;text-sm" font-semibold="" text-slate-700\"="">Email</label>
            <input class="\&quot;mt-1" w-full="" rounded-lg="" border="" border-slate-200="" px-3="" py-2="" text-sm="" outline-none="" focus:border-amber-400\"="" type="\&quot;email\&quot;" name="\&quot;email\&quot;" placeholder="\&quot;tu@email.com\&quot;" required="\&quot;\&quot;">
          </div>
        </div>
        <div>
          <label class="\&quot;text-sm" font-semibold="" text-slate-700\"="">Mensaje</label>
          <textarea class="\&quot;mt-1" w-full="" rounded-lg="" border="" border-slate-200="" px-3="" py-2="" text-sm="" outline-none="" focus:border-amber-400\"="" name="\&quot;mensaje\&quot;" rows="\&quot;4\&quot;" placeholder="\&quot;Cuéntanos" qué="" necesitas\"="" required="\&quot;\&quot;"></textarea>
        </div>
        <button type="\&quot;submit\&quot;" class="\&quot;w-full" rounded-full="" bg-amber-400="" px-5="" py-3="" text-sm="" font-semibold="" text-slate-900="" shadow-lg="" shadow-amber-300="" 40="" transition="" hover:-translate-y-0.5="" hover:bg-amber-300\"="">Enviar</button>
      " | nl2br }} 
 
                        {% endif %}
                    </form>
    </div>
  </div>
</section>
