<section class="booking-form-faqs py-20 bg-white" id="booking">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      <!-- Left: Booking Form -->
      <div>
        
                            {% set formtitle_tag = formtitle_tag ?: 'P' %}
                            {{ ('<' ~ formtitle_tag ~ ' class="text-3xl md:text-4xl font-bold text-gray-900 mb-8" >' ~ (formtitle ? formtitle : 'Booking Form') ~ ('PC8=' | base64_decode) ~ formtitle_tag ~ '>') | raw }}
                        
        <p class="text-gray-600 mb-8">
                        {% if formdescription %} 
 
                            {% if formdescription | isHTML %}
                                {{ formdescription | raw }} 
 
                            {% else %}
                                {{ formdescription | nl2br }} 
 
                            {% endif %}
                        {% else %} 
 
                            {{ "Dorem ipsum dolor sit amet, consectetur adipiscing elit. Nunc vulputate libero et velit interdum." | nl2br }} 
 
                        {% endif %}
                    </p>
        
        <form id="2nbyveq1g" class="booking-form-faqs__form space-y-4">
                    
 {% set variables = {"firstname":{"type":"text","required":true},"lastname":{"type":"text","required":true},"email":{"type":"text","required":true},"phone":{"type":"text"},"service":{"type":"select","required":true},"date":{"type":"text"},"form":{"type":"hidden"}} %} 

                    
 {% set form = cocoForm({
                        'id' : '2nbyveq1g',
                        'tableName' : 'reservas',
                        'mailRecord_null' : null,
                        'sendTo_null' : "",
                        'sendToClient_null' : "",
                        'captcha' : false,
                        'honeypot' : true,
                        'messageOK' : 'Thank you! Your booking request has been submitted.',
                        'showImages' : false,
                        'attachFiles' : false,
                        'messageKO' : 'Please fill in all required fields.',
                        'action' : 'null',
                        'redirectTo' : 'null',
                        'emailMode' : 'null',
                        'emailB64' : false,
                        'header_null' : "",
                        'footer_null' : "",
                        'styles_null' : "",
                        'variables' : variables
                    }) %}

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <input name="cocoForm[firstname]" type="text" placeholder="First Name*" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:border-[#00A6CE]" required="">
            </div>
            <div>
              <input name="cocoForm[lastname]" type="text" placeholder="Last Name*" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:border-[#00A6CE]" required="">
            </div>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <input name="cocoForm[email]" type="text" placeholder="Email*" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:border-[#00A6CE]" required="">
            </div>
            <div>
              <input name="cocoForm[phone]" type="text" placeholder="Phone" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:border-[#00A6CE]">
            </div>
          </div>
          <div>
            <select name="cocoForm[service]" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:border-[#00A6CE]" required="">
              <option value="">Select Service*</option>
              <option value="yacht">Yacht Rental</option>
              <option value="speedboat">Speedboat Rental</option>
              <option value="catamaran">Catamaran Charter</option>
              <option value="party">Party Boat</option>
            </select>
          </div>
          <div>
            <input name="cocoForm[date]" type="text" placeholder="Preferred Date" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:border-[#00A6CE]">
          </div>
          <button type="submit" class="w-full bg-[#00A6CE] hover:bg-[#0095BA] text-white px-8 py-4 rounded-lg font-semibold transition-colors">
            Submit
          </button>
        <input name="cocoForm[form]" type="hidden" value="2nbyveq1g"><div>

<div class="field seturecap">

    <input type="text" id="full_user_name" name="cocoForm[full_user_name]" placeholder="Nombre" class="form-control">

    <style>.seturecap {position: absolute;width: 1px;height: 1px;padding: 0;margin: -1px;overflow: hidden;clip: rect(0, 0, 0, 0);white-space: nowrap;border-width: 0;}</style>

</div>


</div></form>
      </div>
      
      <!-- Right: FAQs -->
      <div>
        
                            {% set faqtitle_tag = faqtitle_tag ?: 'P' %}
                            {{ ('<' ~ faqtitle_tag ~ ' class="text-3xl md:text-4xl font-bold text-gray-900 mb-8" >' ~ (faqtitle ? faqtitle : 'Boat Rental FAQ's') ~ ('PC8=' | base64_decode) ~ faqtitle_tag ~ '>') | raw }}
                        
        <p class="text-gray-600 mb-8">
                        {% if faqdescription %} 
 
                            {% if faqdescription | isHTML %}
                                {{ faqdescription | raw }} 
 
                            {% else %}
                                {{ faqdescription | nl2br }} 
 
                            {% endif %}
                        {% else %} 
 
                            {{ "Dorem ipsum dolor sit amet, consectetur adipiscing elit. Nunc vulputate libero et velit interdum." | nl2br }} 
 
                        {% endif %}
                    </p>
        
        <div class="space-y-4">
          
{% for record in faqs %} {% set index = loop.index0 %}
<div class="booking-form-faqs__faq border border-gray-200 rounded-xl overflow-hidden">
            <button type="button" class="booking-form-faqs__faq-trigger w-full flex items-center justify-between p-5 text-left bg-white hover:bg-gray-50 transition-colors">
              <span class="font-semibold text-gray-900">
                        {% if record.question %} 
 
                            {{ record.question | raw }} 
 
                        {% else %} 
 
                            {{ "How do I book a yacht for my trip?" | raw }} 
 
                        {% endif %}
                    </span>
              <svg class="w-5 h-5 text-[#00A6CE] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>
            <div class="booking-form-faqs__faq-content px-5 pb-5">
              <p class="text-gray-600">
                        {% if record.answer %} 
 
                            {% if record.answer | isHTML %}
                                {{ record.answer | raw }} 
 
                            {% else %}
                                {{ record.answer | nl2br }} 
 
                            {% endif %}
                        {% else %} 
 
                            {{ "Dorem ipsum dolor sit amet, consectetur adipiscing elit. Nunc vulputate libero et velit interdum, ac aliquet odio mattis." | nl2br }} 
 
                        {% endif %}
                    </p>
            </div>
          </div>
{% endfor %}

        </div>
      </div>
    </div>
  </div>
</section>