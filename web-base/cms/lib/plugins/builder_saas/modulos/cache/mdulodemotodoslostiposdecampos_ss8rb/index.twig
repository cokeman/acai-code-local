<div class="modulo-tipos-campos">
  <h2>Módulo Demo - Todos los Tipos de Campos Editables</h2>
  
  <div class="campo-item">
    <label>Campo Textfield (Texto corto)</label>
    <input type="text" placeholder="Escribe un texto corto aquí">
  </div>

  <div class="campo-item">
    <label>Campo Textbox (Texto largo)</label>
    <textarea rows="4" placeholder="Escribe un texto largo aquí">
                        {% if textolargo %} 
 
                            {% if textolargo | isHTML %}
                                {{ textolargo | raw }} 
 
                            {% else %}
                                {{ textolargo | nl2br }} 
 
                            {% endif %}
                        {% else %} 
 
                            {{ "" | nl2br }} 
 
                        {% endif %}
                    </textarea>
  </div>

  <div class="campo-item">
    <label>Campo WYSIWYG (Editor de texto enriquecido)</label>
    <div>
                        {% if contenidoenriquecido %} 
 
                            {{ contenidoenriquecido | raw }} 
 
                        {% else %} 
 
                            {{ "
      <p>Escribe contenido con formato aquí</p>
    " | raw }} 
 
                        {% endif %}
                    </div>
  </div>

  <div class="campo-item">
    <label>Campo Upload (Imagen)</label>
    <img src="{{ imagenprincipal.0.urlPath | imagec(1600) }}">
  </div>

  <div class="campo-item">
    <label>Campo Upload Múltiple (Galería)</label>
    <img src="{{ galeradeimgenes.0.urlPath | imagec(1600) }}">
  </div>

  <div class="campo-item">
    <label>Campo List - Pulldown (Desplegable)</label>
    
 
                        {% set list_values = seleccinsimple | trim | split("	") %} 

                    
 
                        {% if record %} 
 
                            {% set auxRecord = record %} 
 
                        {% endif %} 

                    
 
                        
                        {% for record in list_values %} 
 
                            {% set index = loop.index0 %} 
 
                    <select>
      <option value="">Selecciona una opción</option>
      <option value="opcion1">Opción 1</option>
      <option value="opcion2">Opción 2</option>
      <option value="opcion3">Opción 3</option>
    </select>

                        {% endfor %}

                        {% if auxRecord %} {% set record = auxRecord %} {% endif %}
                    
  </div>

  <div class="campo-item">
    <label>Campo List - Radios (Botones de opción)</label>
    
 
                        {% set list_values = seleccinradio | trim | split("	") %} 

                    
 
                        {% if record %} 
 
                            {% set auxRecord = record %} 
 
                        {% endif %} 

                    
 
                        
                        {% for record in list_values %} 
 
                            {% set index = loop.index0 %} 
 
                    <div>
      <label><input type="radio" name="radio-group" value="radio1"> Opción Radio 1</label>
      <label><input type="radio" name="radio-group" value="radio2"> Opción Radio 2</label>
      <label><input type="radio" name="radio-group" value="radio3"> Opción Radio 3</label>
    </div>

                        {% endfor %}

                        {% if auxRecord %} {% set record = auxRecord %} {% endif %}
                    
  </div>

  <div class="campo-item">
    <label>Campo List - Checkboxes (Casillas múltiples)</label>
    
 
                        {% set list_values = seleccinmltiple | trim | split("	") %} 

                    
 
                        {% if record %} 
 
                            {% set auxRecord = record %} 
 
                        {% endif %} 

                    
 
                        
                        {% for record in list_values %} 
 
                            {% set index = loop.index0 %} 
 
                    <div>
      <label><input type="checkbox" value="check1"> Opción Checkbox 1</label>
      <label><input type="checkbox" value="check2"> Opción Checkbox 2</label>
      <label><input type="checkbox" value="check3"> Opción Checkbox 3</label>
    </div>

                        {% endfor %}

                        {% if auxRecord %} {% set record = auxRecord %} {% endif %}
                    
  </div>

  <div class="campo-item">
    <label>Campo Checkbox (Booleano)</label>
    <label><input type="checkbox"> Activar esta opción</label>
  </div>

  <div class="campo-item">
    <label>Campo Date (Fecha)</label>
    <input type="date">
  </div>

  <div class="campo-item">
    <label>Campo Multitext (Texto múltiple)</label>
    <div>
                        {% if listadetextos %} 
 
                            {{ listadetextos | raw }} 
 
                        {% else %} 
 
                            {{ "
      <input type="\&quot;text\&quot;" placeholder="\&quot;Texto" 1\"="">
      <input type="\&quot;text\&quot;" placeholder="\&quot;Texto" 2\"="">
      <input type="\&quot;text\&quot;" placeholder="\&quot;Texto" 3\"="">
    " | raw }} 
 
                        {% endif %}
                    </div>
  </div>

  <div class="campo-item">
    <label>Campo Código (Editor de código)</label>
    <textarea rows="6" placeholder="Escribe código aquí (HTML, CSS, JS, etc.)">
                        {% if cdigopersonalizado %} 
 
                            {{ cdigopersonalizado | raw }} 
 
                        {% else %} 
 
                            {{ "" | raw }} 
 
                        {% endif %}
                    </textarea>
  </div>

  <div class="campo-item">
    <div>
                        {% if separadorvisual %} 
 
                            {{ separadorvisual | raw }} 
 
                        {% else %} 
 
                            {{ "" | raw }} 
 
                        {% endif %}
                    </div>
  </div>

  <div class="campo-item">
    <label>Campo None (Solo visual, no editable)</label>
    <div>
                        {% if contenidofijo %} 
 
                            {{ contenidofijo | raw }} 
 
                        {% else %} 
 
                            {{ "
      Este contenido es fijo y no se puede editar desde el editor de módulos.
    " | raw }} 
 
                        {% endif %}
                    </div>
  </div>

  <div class="campo-item">
    <label>Ejemplo con Condicionales (c-if)</label>
    <label><input type="checkbox"> Mostrar contenido adicional</label>
    
{% if mostrarcontenido %}
<div>
      <p>Este contenido solo se muestra si el checkbox está activado.</p>
    </div>
{% endif %}

  </div>

  <div class="campo-item">
    <label>Ejemplo con Bucles (c-for)</label>
    <div>
                        {% if itemsdelista %} 
 
                            {{ itemsdelista | raw }} 
 
                        {% else %} 
 
                            {{ "
      <input type="\&quot;text\&quot;" placeholder="\&quot;Item" 1\"="">
      <input type="\&quot;text\&quot;" placeholder="\&quot;Item" 2\"="">
    " | raw }} 
 
                        {% endif %}
                    </div>
    
 {% for item in itemsdelista %} 
<ul>
      <li>{{ item }}</li>
    </ul>
 {% endfor %} 

  </div>
</div>