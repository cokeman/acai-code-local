<div class="modulo-tipos-campos p-8 max-w-4xl mx-auto">
  <h2 class="text-3xl font-bold mb-8 text-center">Módulo Demo - Todos los Tipos de Campos Editables</h2>
  
  <!-- Campo Textfield -->
  <div class="mb-6 p-4 border rounded-lg">
    <label class="block text-sm font-semibold mb-2">Campo Textfield (Texto corto)</label>
    <input type="text" class="w-full px-4 py-2 border rounded" placeholder="Escribe un texto corto aquí">
  </div>

  <!-- Campo Textbox -->
  <div class="mb-6 p-4 border rounded-lg">
    <label class="block text-sm font-semibold mb-2">Campo Textbox (Texto largo)</label>
    <textarea class="w-full px-4 py-2 border rounded" rows="4" placeholder="Escribe un texto largo aquí">
                        {% if textolargo %} 
 
                            {% if textolargo | isHTML %}
                                {{ textolargo | raw }} 
 
                            {% else %}
                                {{ textolargo | nl2br }} 
 
                            {% endif %}
                        {% else %} 
 
                            {{ "" | nl2br }} 
 
                        {% endif %}
                    </textarea>
  </div>

  <!-- Campo WYSIWYG -->
  <div class="mb-6 p-4 border rounded-lg">
    <label class="block text-sm font-semibold mb-2">Campo WYSIWYG (Editor de texto enriquecido)</label>
    <div class="w-full px-4 py-2 border rounded min-h-[200px]">
                        {% if contenidoenriquecido %} 
 
                            {{ contenidoenriquecido | raw }} 
 
                        {% else %} 
 
                            {{ "
      <p>Escribe contenido con formato aquí</p>
    " | raw }} 
 
                        {% endif %}
                    </div>
  </div>

  <!-- Campo Upload (Imagen) -->
  <div class="mb-6 p-4 border rounded-lg">
    <label class="block text-sm font-semibold mb-2">Campo Upload (Imagen)</label>
    <img src="{{ imagenprincipal.0.urlPath | imagec(1600) }}" class="w-full border-2 border-dashed rounded-lg p-8 text-center">
  </div>

  <!-- Campo Upload Múltiple -->
  <div class="mb-6 p-4 border rounded-lg">
    <label class="block text-sm font-semibold mb-2">Campo Upload Múltiple (Galería)</label>
    <img src="{{ galeradeimgenes.0.urlPath | imagec(1600) }}" class="w-full border-2 border-dashed rounded-lg p-8 text-center">
  </div>

  <!-- Campo List (Pulldown) -->
  <div class="mb-6 p-4 border rounded-lg">
    <label class="block text-sm font-semibold mb-2">Campo List - Pulldown (Desplegable)</label>
    
 
                        {% set list_values = seleccinsimple | trim | split("	") %} 

                    
 
                        {% if record %} 
 
                            {% set auxRecord = record %} 
 
                        {% endif %} 

                    
 
                        
                        {% for record in list_values %} 
 
                            {% set index = loop.index0 %} 
 
                    <select class="w-full px-4 py-2 border rounded">
      <option value="">Selecciona una opción</option>
      <option value="opcion1">Opción 1</option>
      <option value="opcion2">Opción 2</option>
      <option value="opcion3">Opción 3</option>
    </select>

                        {% endfor %}

                        {% if auxRecord %} {% set record = auxRecord %} {% endif %}
                    
  </div>

  <!-- Campo List (Radios) -->
  <div class="mb-6 p-4 border rounded-lg">
    <label class="block text-sm font-semibold mb-2">Campo List - Radios (Botones de opción)</label>
    
 
                        {% set list_values = seleccinradio | trim | split("	") %} 

                    
 
                        {% if record %} 
 
                            {% set auxRecord = record %} 
 
                        {% endif %} 

                    
 
                        
                        {% for record in list_values %} 
 
                            {% set index = loop.index0 %} 
 
                    <div class="space-y-2">
      <label class="flex items-center">
        <input type="radio" name="radio-group" value="radio1" class="mr-2">
        <span>Opción Radio 1</span>
      </label>
      <label class="flex items-center">
        <input type="radio" name="radio-group" value="radio2" class="mr-2">
        <span>Opción Radio 2</span>
      </label>
      <label class="flex items-center">
        <input type="radio" name="radio-group" value="radio3" class="mr-2">
        <span>Opción Radio 3</span>
      </label>
    </div>

                        {% endfor %}

                        {% if auxRecord %} {% set record = auxRecord %} {% endif %}
                    
  </div>

  <!-- Campo List (Checkboxes) -->
  <div class="mb-6 p-4 border rounded-lg">
    <label class="block text-sm font-semibold mb-2">Campo List - Checkboxes (Casillas múltiples)</label>
    
 
                        {% set list_values = seleccinmltiple | trim | split("	") %} 

                    
 
                        {% if record %} 
 
                            {% set auxRecord = record %} 
 
                        {% endif %} 

                    
 
                        
                        {% for record in list_values %} 
 
                            {% set index = loop.index0 %} 
 
                    <div class="space-y-2">
      <label class="flex items-center">
        <input type="checkbox" value="check1" class="mr-2">
        <span>Opción Checkbox 1</span>
      </label>
      <label class="flex items-center">
        <input type="checkbox" value="check2" class="mr-2">
        <span>Opción Checkbox 2</span>
      </label>
      <label class="flex items-center">
        <input type="checkbox" value="check3" class="mr-2">
        <span>Opción Checkbox 3</span>
      </label>
    </div>

                        {% endfor %}

                        {% if auxRecord %} {% set record = auxRecord %} {% endif %}
                    
  </div>

  <!-- Campo Checkbox (Booleano) -->
  <div class="mb-6 p-4 border rounded-lg">
    <label class="block text-sm font-semibold mb-2">Campo Checkbox (Booleano)</label>
    <label class="flex items-center">
      <input type="checkbox" class="mr-2">
      <span>Activar esta opción</span>
    </label>
  </div>

  <!-- Campo Date -->
  <div class="mb-6 p-4 border rounded-lg">
    <label class="block text-sm font-semibold mb-2">Campo Date (Fecha)</label>
    <input type="date" class="w-full px-4 py-2 border rounded">
  </div>

  <!-- Campo Multitext -->
  <div class="mb-6 p-4 border rounded-lg">
    <label class="block text-sm font-semibold mb-2">Campo Multitext (Texto múltiple)</label>
    <div class="space-y-2">
                        {% if listadetextos %} 
 
                            {{ listadetextos | raw }} 
 
                        {% else %} 
 
                            {{ "
      <input type="\&quot;text\&quot;" class="\&quot;w-full" px-4="" py-2="" border="" rounded\"="" placeholder="\&quot;Texto" 1\"="">
      <input type="\&quot;text\&quot;" class="\&quot;w-full" px-4="" py-2="" border="" rounded\"="" placeholder="\&quot;Texto" 2\"="">
      <input type="\&quot;text\&quot;" class="\&quot;w-full" px-4="" py-2="" border="" rounded\"="" placeholder="\&quot;Texto" 3\"="">
    " | raw }} 
 
                        {% endif %}
                    </div>
  </div>

  <!-- Campo Código -->
  <div class="mb-6 p-4 border rounded-lg">
    <label class="block text-sm font-semibold mb-2">Campo Código (Editor de código)</label>
    <textarea class="w-full px-4 py-2 border rounded font-mono text-sm" rows="6" placeholder="Escribe código aquí (HTML, CSS, JS, etc.)">
                        {% if cdigopersonalizado %} 
 
                            {{ cdigopersonalizado | raw }} 
 
                        {% else %} 
 
                            {{ "" | raw }} 
 
                        {% endif %}
                    </textarea>
  </div>

  <!-- Separador -->
  <div class="mb-6">
    <div class="border-t-2 border-gray-300 my-4">
                        {% if separadorvisual %} 
 
                            {{ separadorvisual | raw }} 
 
                        {% else %} 
 
                            {{ "" | raw }} 
 
                        {% endif %}
                    </div>
  </div>

  <!-- Campo None (No editable, solo visual) -->
  <div class="mb-6 p-4 border rounded-lg bg-gray-50">
    <label class="block text-sm font-semibold mb-2">Campo None (Solo visual, no editable)</label>
    <div class="text-gray-600">
                        {% if contenidofijo %} 
 
                            {{ contenidofijo | raw }} 
 
                        {% else %} 
 
                            {{ "
      Este contenido es fijo y no se puede editar desde el editor de módulos.
    " | raw }} 
 
                        {% endif %}
                    </div>
  </div>

  <!-- Ejemplo de uso con c-if -->
  <div class="mb-6 p-4 border rounded-lg bg-blue-50">
    <label class="block text-sm font-semibold mb-2">Ejemplo con Condicionales (c-if)</label>
    <label class="flex items-center mb-4">
      <input type="checkbox" class="mr-2">
      <span>Mostrar contenido adicional</span>
    </label>
    
{% if mostrarcontenido %}
<div class="p-4 bg-white rounded border">
      <p>Este contenido solo se muestra si el checkbox está activado.</p>
    </div>
{% endif %}

  </div>

  <!-- Ejemplo de uso con c-for -->
  <div class="mb-6 p-4 border rounded-lg bg-green-50">
    <label class="block text-sm font-semibold mb-2">Ejemplo con Bucles (c-for)</label>
    <div class="mb-4">
                        {% if itemsdelista %} 
 
                            {{ itemsdelista | raw }} 
 
                        {% else %} 
 
                            {{ "
      <input type="\&quot;text\&quot;" class="\&quot;w-full" px-4="" py-2="" border="" rounded="" mb-2\"="" placeholder="\&quot;Item" 1\"="">
      <input type="\&quot;text\&quot;" class="\&quot;w-full" px-4="" py-2="" border="" rounded="" mb-2\"="" placeholder="\&quot;Item" 2\"="">
    " | raw }} 
 
                        {% endif %}
                    </div>
    
 {% for item in itemsdelista %} 
<ul class="list-disc list-inside space-y-1">
      <li>{{ item }}</li>
    </ul>
 {% endfor %} 

  </div>
</div>