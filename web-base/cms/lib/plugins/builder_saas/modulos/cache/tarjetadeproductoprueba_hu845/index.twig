<div class="product-card-test">
  <!-- Variables ocultas para configuración -->
  

  <!-- Contenedor principal -->
  <div class="max-w-sm mx-auto bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300">
    
    <!-- Imagen del producto -->
    <div class="relative h-64 bg-gray-200">
      <img data-src="{{ imagenproducto.0.urlPath | imagec(800) }}" alt="Imagen del producto" class="absolute top-0 left-0 w-full h-full object-cover object-center lazyload">
      
      <!-- Badge de descuento (condicional) -->
      
{% if {{ mostrardescuento == 'Sí' }} %}
<div class="absolute top-4 right-4 bg-red-500 text-white px-3 py-1 rounded-full text-sm font-bold">
        <span>
                        {% if textodescuento %} 
 
                            {{ textodescuento | raw }} 
 
                        {% else %} 
 
                            {{ "-20%" | raw }} 
 
                        {% endif %}
                    </span>
      </div>
{% endif %}

    </div>

    <!-- Contenido de la tarjeta -->
    <div class="p-6">
      <!-- Categoría -->
      <div class="text-sm text-gray-500 uppercase tracking-wide mb-2">
        <span>
                        {% if categora %} 
 
                            {{ categora | raw }} 
 
                        {% else %} 
 
                            {{ "Electrónica" | raw }} 
 
                        {% endif %}
                    </span>
      </div>

      <!-- Título del producto -->
      
                            {% set ttuloproducto_tag = ttuloproducto_tag ?: 'P' %}
                            {{ ('<' ~ ttuloproducto_tag ~ ' class="text-2xl font-bold text-gray-800 mb-3" >' ~ (ttuloproducto ? ttuloproducto : '
        Producto de Prueba
      ') ~ ('PC8=' | base64_decode) ~ ttuloproducto_tag ~ '>') | raw }}
                        

      <!-- Descripción -->
      <div class="text-gray-600 mb-4 line-clamp-3">
                        {% if descripcin %} 
 
                            {% if descripcin | isHTML %}
                                {{ descripcin | raw }} 
 
                            {% else %}
                                {{ descripcin | nl2br }} 
 
                            {% endif %}
                        {% else %} 
 
                            {{ "
        Esta es una descripción de prueba para el producto. Puedes editar este texto desde el editor visual.
      " | nl2br }} 
 
                        {% endif %}
                    </div>

      <!-- Precio (condicional) -->
      
{% if {{ mostrarprecio == 'Sí' }} %}
<div class="mb-4">
        <div class="flex items-baseline gap-2">
          <span class="text-3xl font-bold text-blue-600">
                        {% if precio %} 
 
                            {{ precio | raw }} 
 
                        {% else %} 
 
                            {{ "$99.99" | raw }} 
 
                        {% endif %}
                    </span>
          <span class="text-lg text-gray-400 line-through">
                        {% if preciooriginal %} 
 
                            {{ preciooriginal | raw }} 
 
                        {% else %} 
 
                            {{ "$129.99" | raw }} 
 
                        {% endif %}
                    </span>
        </div>
      </div>
{% endif %}


      <!-- Características -->
      <div class="mb-6">
        <h4 class="text-sm font-semibold text-gray-700 mb-2">Características:</h4>
        <ul class="space-y-1">
          
{% for record in caractersticas %} {% set index = loop.index0 %}
<li class="flex items-start gap-2">
            <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
            <span class="text-gray-700 text-sm">
                        {% if record.textocaracterstica %} 
 
                            {{ record.textocaracterstica | raw }} 
 
                        {% else %} 
 
                            {{ "
              Característica del producto
            " | raw }} 
 
                        {% endif %}
                    </span>
          </li>
{% endfor %}

        </ul>
      </div>

      <!-- Botones de acción -->
      <div class="flex gap-3">
        <a href="{{ enlacecomprar }}" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-lg text-center transition-colors duration-200"><span><? echo @$textobotncomprar ? nl2br($textobotncomprar) : 'Comprar Ahora';?></span>
        </a>
        
        <a href="{{ enlaceverms }}" class="flex-1 bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-3 px-4 rounded-lg text-center transition-colors duration-200"><span><? echo @$textobotnverms ? nl2br($textobotnverms) : 'Ver Detalles';?></span>
        </a>
      </div>
    </div>
  </div>
</div>