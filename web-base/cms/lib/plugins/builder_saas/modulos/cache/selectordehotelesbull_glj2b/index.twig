<section class="py-16 bg-white">
  <div class="container mx-auto px-4">
    <!-- Título Principal -->
    <div class="max-w-3xl mb-12">
      
                            {% set tituloprincipal_tag = tituloprincipal_tag ?: 'P' %}
                            {{ ('<' ~ tituloprincipal_tag ~ ' class="text-5xl font-bold leading-tight mb-6" >' ~ (tituloprincipal ? tituloprincipal : '
        Escoge tu hotel y <span class="\&quot;text-red-600\&quot;">disfrútalo al máximo</span>
      ') ~ ('PC8=' | base64_decode) ~ tituloprincipal_tag ~ '>') | raw }}
                        
    </div>

    <!-- Grid de Hoteles -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
      <!-- Hotel Cards Loop -->
      
 {% for hotel in hoteles %} 
<div class="relative">
        
 {% set tw_class = ['border rounded-3xl px-8 py-4 transition-all duration-300 hover:shadow-xl cursor-pointer'] %} 

 {% if 'bg-white border-red-600 %} {% set tw_class = tw_class|merge([otel.destacado ? 'bg-red-600 border-red-600 shadow-2xl']) %} {% endif %} 
 <div class="{{tw_class|join(' ')}}">
          
 {% set tw_class = ['text-lg font-bold'] %} 

 {% if 'text-gray-800 %} {% set tw_class = tw_class|merge([otel.destacado ? 'text-white']) %} {% endif %} 
 <h3 class="{{tw_class|join(' ')}}">
            {{ hotel.nombre }}
          </h3>
        </div>
      </div>
 {% endfor %} 

    </div>

    <!-- Mockup Section -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center mt-16">
      <!-- Imagen del Mockup -->
      <div class="relative">
        <img c-src="imagenmockup[0].urlPath | imagec(800)" alt="App móvil Bull Hotels" class="w-full h-auto drop-shadow-2xl">
      </div>

      <!-- Contenido -->
      <div>
        
                            {% set titulosecundario_tag = titulosecundario_tag ?: 'P' %}
                            {{ ('<' ~ titulosecundario_tag ~ ' class="text-4xl font-bold mb-6" >' ~ (titulosecundario ? titulosecundario : '
          Una App diseñada <span class="\&quot;text-red-600\&quot;">para ti</span>
        ') ~ ('PC8=' | base64_decode) ~ titulosecundario_tag ~ '>') | raw }}
                        
        <p class="text-xl text-gray-700 leading-relaxed">
                        {% if descripcion %} 
 
                            {% if descripcion | isHTML %}
                                {{ descripcion | raw }} 
 
                            {% else %}
                                {{ descripcion | nl2br }} 
 
                            {% endif %}
                        {% else %} 
 
                            {{ "
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Eget enim congue consectetur turpis at viverra pretium scelerisque lorem.
        " | nl2br }} 
 
                        {% endif %}
                    </p>

        <!-- Features -->
        <div class="mt-8 space-y-4">
          
 {% for feature in caracteristicas %} 
<div class="flex items-center gap-4 bg-white border border-red-600 rounded-xl px-6 py-3">
            <span class="text-gray-800 font-medium">{{ feature.nombre }}</span>
          </div>
 {% endfor %} 

        </div>
      </div>
    </div>
  </div>
</section>