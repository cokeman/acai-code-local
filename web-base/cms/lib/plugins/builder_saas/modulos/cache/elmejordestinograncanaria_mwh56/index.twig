<div class="gran-canaria-section relative py-20 overflow-hidden">
  <!-- Background Pattern -->
  <div class="gran-canaria-section__bg-pattern absolute inset-0 opacity-20 pointer-events-none">
    <img src="https://acai-s3.s3.eu-west-3.amazonaws.com/uploads/chat/59-1567/background-pattern-hotels-mjan3xts-emt4jr.png" alt="" class="w-full h-full object-cover">
  </div>

  <div class="gran-canaria-section__container container mx-auto px-4 relative z-10">
    <!-- Título y descripción -->
    <div class="text-center mb-12">
      
                            {% set ttulo_tag = ttulo_tag ?: 'P' %}
                            {{ ('<' ~ ttulo_tag ~ ' class="text-5xl font-normal mb-6 text-[#252525]" >' ~ (ttulo ? ttulo : '
        El mejor destino, Gran Canaria
      ') ~ ('PC8=' | base64_decode) ~ ttulo_tag ~ '>') | raw }}
                        
      <p class="text-lg text-[#252525] max-w-4xl mx-auto leading-relaxed">
                        {% if descripcin %} 
 
                            {% if descripcin | isHTML %}
                                {{ descripcin | raw }} 
 
                            {% else %}
                                {{ descripcin | nl2br }} 
 
                            {% endif %}
                        {% else %} 
 
                            {{ "
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Dolor convallis cursus est nisi, ultricies laoreet. Elit condimentum eros, massa risus duis vitae viverra adipiscing. Tempor sapien, pharetra cursus a aliquam, quam neque neque, mauris.
      " | nl2br }} 
 
                        {% endif %}
                    </p>
    </div>

    <!-- Grid de Hoteles -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
      <!-- Hotel 1 -->
      
{% for record in hoteles %} {% set index = loop.index0 %}
<div class="gran-canaria-section__hotel relative rounded-[20px] overflow-hidden h-[400px]">
        <img class="absolute inset-0 w-full h-full object-cover" src="{{ record.imagenhotel.0.urlPath | imagec(800) }}" alt="">
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
        
        <!-- Contenido sobre la imagen -->
        <div class="absolute bottom-0 left-0 right-0 p-8 text-white">
          <!-- Logo Bull -->
          <img src="https://acai-s3.s3.eu-west-3.amazonaws.com/uploads/chat/59-1567/bull-logo-1-mjan3tte-nloegq.png" alt="Bull Hotels" class="w-32 mb-4">
          
          <!-- Nombre del hotel -->
          <h3 class="text-2xl font-bold mb-3 leading-tight">
                        {% if record.nombrehotel %} 
 
                            {{ record.nombrehotel | raw }} 
 
                        {% else %} 
 
                            {{ "
            BULL REINA ISABEL &amp; SPA<br>****
          " | raw }} 
 
                        {% endif %}
                    </h3>
          
          <!-- Iconos de características -->
          <div class="flex gap-4 mb-4">
            
{% if spa %}
<div class="gran-canaria-section__icon-group">
              <span class="text-sm opacity-80">Spa</span>
            </div>
{% endif %}

            
{% if playa %}
<div class="gran-canaria-section__icon-group">
              <span class="text-sm opacity-80">Playa</span>
            </div>
{% endif %}

            
{% if ciudad %}
<div class="gran-canaria-section__icon-group">
              <span class="text-sm opacity-80">Ciudad</span>
            </div>
{% endif %}

            
{% if todoincluido %}
<div class="gran-canaria-section__icon-group">
              <span class="text-sm opacity-80">Todo incluido</span>
            </div>
{% endif %}

            
{% if soloadultos %}
<div class="gran-canaria-section__icon-group">
              <span class="text-sm opacity-80">Sólo adultos</span>
            </div>
{% endif %}

            
{% if familias %}
<div class="gran-canaria-section__icon-group">
              <span class="text-sm opacity-80">Familias</span>
            </div>
{% endif %}

          </div>

          <!-- Variables ocultas para características -->
          
          
          <!-- Botón Ver hotel -->
          <a href="{{ record.enlacehotel }}" class="inline-flex items-center gap-2 bg-white text-[#FF0000] px-6 py-3 rounded-full font-bold text-base hover:bg-gray-100 transition-colors">Ver hotel
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="w-5 h-5">
              <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
      </div>
{% endfor %}

    </div>

    <!-- Renderizar hoteles desde multiv2 -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
      
 {% for hotel in hoteles %} 
<div class="gran-canaria-section__hotel relative rounded-[20px] overflow-hidden h-[400px]">
        <img class="absolute inset-0 w-full h-full object-cover" src="{{ hotel.imagenhotel[0].urlPath | imagec(800) }}" alt="{{ hotel.nombrehotel }}">
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
        
        <div class="absolute bottom-0 left-0 right-0 p-8 text-white">
          <img src="https://acai-s3.s3.eu-west-3.amazonaws.com/uploads/chat/59-1567/bull-logo-1-mjan3tte-nloegq.png" alt="Bull Hotels" class="w-32 mb-4">
          
          <h3 class="text-2xl font-bold mb-3 leading-tight">
            {{ hotel.nombrehotel }}
          </h3>
          
          <div class="flex gap-4 mb-4 flex-wrap">
            
{% if hotel.spa = 1 %}
<span class="text-sm opacity-80">Spa</span>
{% endif %}

            
{% if hotel.playa = 1 %}
<span class="text-sm opacity-80">Playa</span>
{% endif %}

            
{% if hotel.ciudad = 1 %}
<span class="text-sm opacity-80">Ciudad</span>
{% endif %}

            
{% if hotel.todoincluido = 1 %}
<span class="text-sm opacity-80">Todo incluido</span>
{% endif %}

            
{% if hotel.soloadultos = 1 %}
<span class="text-sm opacity-80">Sólo adultos</span>
{% endif %}

            
{% if hotel.familias = 1 %}
<span class="text-sm opacity-80">Familias</span>
{% endif %}

          </div>
          
          <a href="{{ hotel.enlacehotel }}" class="inline-flex items-center gap-2 bg-white text-[#FF0000] px-6 py-3 rounded-full font-bold text-base hover:bg-gray-100 transition-colors">
            Ver hotel
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="w-5 h-5">
              <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
      </div>
 {% endfor %} 

    </div>
  </div>
</div>