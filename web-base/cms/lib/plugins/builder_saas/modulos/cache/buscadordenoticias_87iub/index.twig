<div class="buscador-noticias">
  <div class="buscador-noticias__container max-w-6xl mx-auto px-4 py-8">
    <!-- Campo de búsqueda -->
    <div class="buscador-noticias__search mb-8">
      <div class="relative">
        <input type="text" v-model="searchQuery" @input="handleSearch" placeholder="Buscar noticias..." class="buscador-noticias__input w-full px-6 py-4 text-lg border-2 border-gray-300 rounded-lg focus:outline-none focus:border-blue-500 transition-colors">
        <svg class="buscador-noticias__icon absolute right-4 top-1/2 transform -translate-y-1/2 w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>
    </div>

    <!-- Mensaje de estado -->
    <div v-if="isSearching" class="buscador-noticias__loading text-center py-8">
      <p class="text-gray-600">Buscando...</p>
    </div>

    <!-- Resultados -->
    <div v-if="!isSearching &amp;&amp; resultados.length > 0" class="buscador-noticias__results">
      <div class="buscador-noticias__count mb-6">
        <p class="text-gray-700">
          Se encontraron <strong>{{ resultados.length }}</strong> noticia(s)
        </p>
      </div>

      <div class="buscador-noticias__grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <article v-for="noticia in resultados" :key="noticia.num" class="buscador-noticias__card bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition-shadow">
          <!-- Imagen destacada -->
          <div v-if="noticia.imagen_destacada &amp;&amp; noticia.imagen_destacada[0]" class="buscador-noticias__image-wrapper relative h-48 overflow-hidden">
            <img :src="getImageUrl(noticia.imagen_destacada[0].urlPath)" :alt="noticia.title" class="buscador-noticias__image w-full h-full object-cover">
          </div>

          <!-- Contenido -->
          <div class="buscador-noticias__content p-6">
            <div class="buscador-noticias__meta mb-3">
              <span v-if="noticia.fecha_publicacion" class="buscador-noticias__date text-sm text-gray-500">
                {{ formatDate(noticia.fecha_publicacion) }}
              </span>
              <span v-if="noticia.destacado" class="buscador-noticias__badge ml-2 px-2 py-1 bg-yellow-400 text-yellow-900 text-xs font-semibold rounded">
                Destacado
              </span>
            </div>

            <h3 class="buscador-noticias__title text-xl font-bold mb-3 text-gray-800">
              {{ noticia.title }}
            </h3>

            <div class="buscador-noticias__excerpt text-gray-600 mb-4 line-clamp-3" v-html="getExcerpt(noticia.content)"></div>

            <a :href="getNoticiaUrl(noticia)" class="buscador-noticias__link inline-block text-blue-600 font-semibold hover:text-blue-800 transition-colors">
              Leer más →
            </a>
          </div>
        </article>
      </div>
    </div>

    <!-- Sin resultados -->
    <div v-if="!isSearching &amp;&amp; searchQuery &amp;&amp; resultados.length === 0" class="buscador-noticias__no-results text-center py-12">
      <p class="text-gray-600 text-lg mb-2">No se encontraron noticias</p>
      <p class="text-gray-500">Intenta con otros términos de búsqueda</p>
    </div>

    <!-- Estado inicial -->
    <div v-if="!isSearching &amp;&amp; !searchQuery" class="buscador-noticias__initial text-center py-12">
      <p class="text-gray-600 text-lg">Ingresa un término de búsqueda para comenzar</p>
    </div>
  </div>
</div>