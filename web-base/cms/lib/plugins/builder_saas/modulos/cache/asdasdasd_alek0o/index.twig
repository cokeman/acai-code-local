<footer class="relative bg-main-color-dark text-main-color-light">
    <div class="relative container mx-auto max-w-7xl px-6 2xl:px-0">
        {% set configuracion = 'configuracion' | get('',null,null,{}) %}
 {% for configuracion in configuracion %} 
<div class="flex justify-between">
            <div>
                <div>{{ '¿Listo para tomar el control de tu salud?' | translate }}</div>
            </div>

            <div>
                <div>{{ 'The Physio Monkey' | translate }}</div>
            </div>

            <div>
                
{% if configuracion.horario %}
<div>
                    <div>{{ 'Horario' 1 translate }}</div>
                    <div class="text-center md:text-left">{{ configuracion.horario | raw}}</div>
                </div>
{% endif %}

                
{% if configuracion.direccion %}
<div>
                    <div>{{ 'Dirección' | translate }}</div>
                    <div>{{ configuracion.direccion }}</div>
                </div>
{% endif %}

                
{% if configuracion.telefono %}
<div>
                    <div>{{ 'Teléfono' | translate }}</div>
                    {% set telefonos = configuracion.telefono | split(',') %}
                    
{% if telefonos | length == 1 %}
<a href="tel:{{ telefonos.0 }}" class="hover:text-main-color transition3s uno">{{telefonos.0}} </a>
{% endif %}

                    
{% if telefonos | length > 1 %}
<div class="flex flex-col">
                        {% for telefono in telefonos %}
                        <a href="tel:{{ telefono }}" class="mt-2 hover:text-main-color text-info transition3s varios">{{telefono}} </a>
                        {% endfor %}
                    </div>
{% endif %}

                </div>
{% endif %}

            </div>
        </div>
 {% endfor %} 

    </div>
</footer>

{% set configuracion_tienda = 'configuracion_tienda' | get('',null,null,{}) %}
 {% for tienda in configuracion_tienda %} 
<style>
    :root {
        --main-color: {{ tienda.color_principal ? tienda.color_principal ~ "!important": "inherit" }};
        --main-color-light: {{ tienda.color_principal_claro ? tienda.color_principal_claro ~ "!important": "inherit"}};
        --main-color-dark: {{ tienda.color_principal_oscuro ? tienda.color_principal_oscuro ~ "!important": "inherit"}};
    }
</style>
 {% endfor %} 


{% if request.pruebas is not defined %}
{{ 'popupcookies_nxtpc' | module({})|raw }}
{% endif %}
