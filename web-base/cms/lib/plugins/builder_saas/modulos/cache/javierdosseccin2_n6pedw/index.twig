<section class="relative">
    <div class="absolute inset-0 bg-gray-100 pointer-events-none mb-16" aria-hidden="true"></div>
    <div class="absolute left-0 right-0 m-auto w-px p-px h-20 bg-gray-200 transform -translate-y-1/2"></div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6">
        <div class="pt-12 md:pt-20 ">
            <div class="max-w-3xl mx-auto text-center pb-12 md:pb-16">
                {% if ttuloseccin2 %}
                
                            {% set ttuloseccin2_tag = ttuloseccin2_tag ?: 'P' %}
                            {{ ('<' ~ ttuloseccin2_tag ~ ' class="h2 mb-4 tracking-tight" >' ~ (ttuloseccin2 ? ttuloseccin2 : '') ~ ('PC8=' | base64_decode) ~ ttuloseccin2_tag ~ '>') | raw }}
                        
                {% endif %}
                
{% if textodescriptivo %}
<p class="text-xl text-gray-600 wed_textodescriptivo:textfield">
                        {% if textodescriptivo %} 
 
                            {{ textodescriptivo | raw }} 
 
                        {% else %} 
 
                            {{ "" | raw }} 
 
                        {% endif %}
                    </p>
{% endif %}

            </div>
            <div class="md:grid md:grid-cols-12 md:gap-6">
                <div class="max-w-xl md:max-w-none md:w-full mx-auto md:col-span-7 lg:col-span-6 md:mt-6">
                    <div class="md:pr-4 lg:pr-12 xl:pr-16 mb-8">
                        {% if subttulo seccin2 %}
                        
                            {% set subttuloseccin2_tag = subttuloseccin2_tag ?: 'P' %}
                            {{ ('<' ~ subttuloseccin2_tag ~ ' class="h3 mb-3" >' ~ (subttuloseccin2 ? subttuloseccin2 : '') ~ ('PC8=' | base64_decode) ~ subttuloseccin2_tag ~ '>') | raw }}
                        
                        {% endif %}
                        <p c-if"textoseccin2"="" class="text-xl text-gray-600 wed_textoseccin2:textfield">
                        {% if textoseccin2 %} 
 
                            {{ textoseccin2 | raw }} 
 
                        {% else %} 
 
                            {{ "" | raw }} 
 
                        {% endif %}
                    </p>
                    </div>
                    <ul class="mb-8 md:mb-0">
                        
{% for record in elementobloque %} {% set index = loop.index0 %}
<li class="cursor-pointer bloque2 rounded border transition duration-300 ease-in-out mb-3 bg-white shadow-md border-gray-200 hover:shadow-lg ">
                            <a class="flex items-center text-lg p-5 tracking-tight" <div="">
                                    {% ttuloelementobloque %}
                                    
                            {% set record = record|merge({'ttuloelementobloque_tag': record.ttuloelementobloque_tag ?: 'P'})  %}
                            {{ ('<' ~ record.ttuloelementobloque_tag ~ ' class="font-bold leading-snug tracking-tight mb-1" >' ~ (record.ttuloelementobloque ? record.ttuloelementobloque : '') ~ ('PC8=' | base64_decode) ~ record.ttuloelementobloque_tag ~ '>') | raw }}
                        
                                    {% endif%}
                                    
{% if textoelementobloque %}
<p class="text-gray-600 wed_record.textoelementobloque:textfield">
                        {% if record.textoelementobloque %} 
 
                            {{ record.textoelementobloque | raw }} 
 
                        {% else %} 
 
                            {{ "" | raw }} 
 
                        {% endif %}
                    </p>
{% endif %}

                                </a></li>
{% endfor %}
</ul></div><a class="flex items-center text-lg p-5 tracking-tight" <div="">
                                
{% if imagenelementobloque %}
<div class="flex justify-center items-center w-8 h-8 bg-white rounded-full shadow flex-shrink-0 ml-3">
                                    <img src="{{ imagenelementobloque.0.urlPath | imagec(1600) }}" class="lazyload w-3 h-3 fill-current">
                                </div>
{% endif %}

                            </a>
                        
                    
                </div>
                <div class="max-w-xl md:max-w-none md:w-full mx-auto md:col-span-5 lg:col-span-6 mb-8 md:mb-0 md:order-1">
                    <div class="relative flex flex-col text-center lg:text-right">
                        <div class="w-full appear-done enter-done" style="">
                            <div class="relative inline-flex flex-col"><img class="md:max-w-none mx-auto rounded" src="/template/estandar/practicajavier/features-bg.98e1ab2d.png" width="500" height="462" alt="Features bg"><img class="md:max-w-none absolute w-full left-0 transform animate-float" src="/template/estandar/practicajavier/features-element.02cc9453.png" width="500" height="44" alt="Element" style="top: 30%;"></div>
                        </div>
                        <div class="w-full" style="display: none;">
                            <div class="relative inline-flex flex-col"><img class="md:max-w-none mx-auto rounded" src="/template/estandar/practicajavier/features-bg.98e1ab2d.png" width="500" height="462" alt="Features bg"><img class="md:max-w-none absolute w-full left-0 transform animate-float" src="/template/estandar/practicajavier/features-element.02cc9453.png" width="500" height="44" alt="Element" style="top: 30%;"></div>
                        </div>
                        <div class="w-full" style="display: none;">
                            <div class="relative inline-flex flex-col"><img class="md:max-w-none mx-auto rounded" src="/template/estandar/practicajavier/features-bg.98e1ab2d.png" width="500" height="462" alt="Features bg"><img class="md:max-w-none absolute w-full left-0 transform animate-float" src="/template/estandar/practicajavier/features-element.02cc9453.png" width="500" height="44" alt="Element" style="top: 30%;"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    
</section>
<style>
    .bloque2:nth-of-type(1) {
           background-color: #fbfbfb;
        border: transparent;
        box-shadow: none;
    }
</style>