<section class="servicios-prueba w-full bg-gray-50 py-12 px-6 md:px-12">
  <div class="max-w-6xl mx-auto">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-10">
      <div class="space-y-3 max-w-3xl">
        <p class="text-sm font-semibold text-indigo-600 tracking-wide uppercase">
                        {% if kicker %} 
 
                            {{ kicker | raw }} 
 
                        {% else %} 
 
                            {{ "Nuestros servicios" | raw }} 
 
                        {% endif %}
                    </p>
        
                            {% set titulo_tag = titulo_tag ?: 'P' %}
                            {{ ('<' ~ titulo_tag ~ ' class="text-3xl md:text-4xl font-bold text-gray-900" >' ~ (titulo ? titulo : '
          Servicios destacados para tu proyecto
        ') ~ ('PC8=' | base64_decode) ~ titulo_tag ~ '>') | raw }}
                        
        <p class="text-base md:text-lg text-gray-600">
                        {% if descripcion %} 
 
                            {% if descripcion | isHTML %}
                                {{ descripcion | raw }} 
 
                            {% else %}
                                {{ descripcion | nl2br }} 
 
                            {% endif %}
                        {% else %} 
 
                            {{ "
          Combinamos estrategia, diseño y tecnología para crear soluciones digitales centradas en resultados.
        " | nl2br }} 
 
                        {% endif %}
                    </p>
      </div>
      <div class="flex items-center gap-3">
        <a class="inline-flex items-center gap-2 px-4 py-3 rounded-lg bg-indigo-600 text-white text-sm font-semibold shadow-lg shadow-indigo-200 transition hover:bg-indigo-700" href="{{ enlacecta }}"><span><? echo @$textocta ? nl2br($textocta) : 'Agenda una llamada';?></span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      
{% for record in servicios %} {% set index = loop.index0 %}
<article class="servicios-prueba__item">
        <div class="h-full rounded-2xl border border-gray-100 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg flex flex-col">
          <div class="flex items-center gap-4 mb-4">
            <div class="h-12 w-12 rounded-full bg-indigo-50 flex items-center justify-center text-indigo-700 font-semibold">
              
{% if service.icono &amp;&amp; service.icono.length %}
<span class="w-full h-full overflow-hidden rounded-full">
                <img src="{{ record.icono.0.urlPath | imagec(1600) }}" alt="Icono servicio" class="w-full h-full object-cover">
              </span> {% else %} <span>{{ service.titulo ? service.titulo | slice(0,1) : 'S' }}</span>
{% endif %}

              
            </div>
            <div class="space-y-1">
              <h3 class="text-lg font-semibold text-gray-900">
                        {% if record.tituloservicio %} 
 
                            {{ record.tituloservicio | raw }} 
 
                        {% else %} 
 
                            {{ "Diseño UX/UI" | raw }} 
 
                        {% endif %}
                    </h3>
              <p class="text-xs font-medium text-gray-500">
                        {% if record.categoria %} 
 
                            {{ record.categoria | raw }} 
 
                        {% else %} 
 
                            {{ "Producto digital" | raw }} 
 
                        {% endif %}
                    </p>
            </div>
          </div>
          <p class="text-sm text-gray-600 leading-relaxed mb-4">
                        {% if record.resumen %} 
 
                            {% if record.resumen | isHTML %}
                                {{ record.resumen | raw }} 
 
                            {% else %}
                                {{ record.resumen | nl2br }} 
 
                            {% endif %}
                        {% else %} 
 
                            {{ "
            Creamos interfaces claras y centradas en el usuario para maximizar conversión y retención.
          " | nl2br }} 
 
                        {% endif %}
                    </p>
          <div class="mt-auto flex items-center gap-2 text-sm font-semibold text-indigo-600">
            <span>
                        {% if record.etiqueta %} 
 
                            {{ record.etiqueta | raw }} 
 
                        {% else %} 
 
                            {{ "Ver detalle" | raw }} 
 
                        {% endif %}
                    </span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </div>
        </div>
      </article>
{% endfor %}

    </div>
  </div>
</section>
