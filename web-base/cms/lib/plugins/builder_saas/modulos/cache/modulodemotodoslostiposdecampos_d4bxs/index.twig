<div class="modulo-tipos-campos">
  <h2>Modulo Demo - Todos los Tipos de Campos Editables</h2>
  
  <div class="campo-item">
    <label>Campo Textfield</label>
    <input type="text">
  </div>

  <div class="campo-item">
    <label>Campo Textbox</label>
    <textarea rows="4">
                        {% if textolargo %} 
 
                            {% if textolargo | isHTML %}
                                {{ textolargo | raw }} 
 
                            {% else %}
                                {{ textolargo | nl2br }} 
 
                            {% endif %}
                        {% else %} 
 
                            {{ "" | nl2br }} 
 
                        {% endif %}
                    </textarea>
  </div>

  <div class="campo-item">
    <label>Campo WYSIWYG</label>
    <div>
                        {% if contenidoenriquecido %} 
 
                            {{ contenidoenriquecido | raw }} 
 
                        {% else %} 
 
                            {{ "
      <p>Escribe contenido con formato aqui</p>
    " | raw }} 
 
                        {% endif %}
                    </div>
  </div>

  <div class="campo-item">
    <label>Campo Upload</label>
    <img src="{{ imagenprincipal.0.urlPath | imagec(1600) }}">
  </div>

  <div class="campo-item">
    <label>Campo List - Pulldown</label>
    
 
                        {% set list_values = seleccionsimple | trim | split("	") %} 

                    
 
                        {% if record %} 
 
                            {% set auxRecord = record %} 
 
                        {% endif %} 

                    
 
                        
                        {% for record in list_values %} 
 
                            {% set index = loop.index0 %} 
 
                    <select>
      <option value="">Selecciona una opcion</option>
      <option value="opcion1">Opcion 1</option>
      <option value="opcion2">Opcion 2</option>
      <option value="opcion3">Opcion 3</option>
    </select>

                        {% endfor %}

                        {% if auxRecord %} {% set record = auxRecord %} {% endif %}
                    
  </div>

  <div class="campo-item">
    <label>Campo Checkbox</label>
    <label><input type="checkbox"> Activar esta opcion</label>
  </div>

  <div class="campo-item">
    <label>Campo Date</label>
    <input type="date">
  </div>

  <div class="campo-item">
    <label>Campo Multitext</label>
    <div>
                        {% if listadetextos %} 
 
                            {{ listadetextos | raw }} 
 
                        {% else %} 
 
                            {{ "
      <input type="\&quot;text\&quot;">
      <input type="\&quot;text\&quot;">
      <input type="\&quot;text\&quot;">
    " | raw }} 
 
                        {% endif %}
                    </div>
  </div>

  <div class="campo-item">
    <label>Campo Codigo</label>
    <textarea rows="6">
                        {% if codigopersonalizado %} 
 
                            {{ codigopersonalizado | raw }} 
 
                        {% else %} 
 
                            {{ "" | raw }} 
 
                        {% endif %}
                    </textarea>
  </div>

  <div class="campo-item">
    <div>
                        {% if separadorvisual %} 
 
                            {{ separadorvisual | raw }} 
 
                        {% else %} 
 
                            {{ "" | raw }} 
 
                        {% endif %}
                    </div>
  </div>

  <div class="campo-item">
    <label>Campo None</label>
    <div>
                        {% if contenidofijo %} 
 
                            {{ contenidofijo | raw }} 
 
                        {% else %} 
 
                            {{ "
      Este contenido es fijo y no se puede editar desde el editor de modulos.
    " | raw }} 
 
                        {% endif %}
                    </div>
  </div>
</div>