<section class="cta-banner-video relative py-24 overflow-hidden">
  <!-- Background Image -->
  <div class="absolute inset-0 z-0">
    <img src="{{ backgroundimage.0.urlPath | imagec(1920) }}" alt="Boats background" class="w-full h-full object-cover">
    <div class="absolute inset-0 bg-[#0a1628]/85"></div>
  </div>
  
  <div class="container mx-auto px-4 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <!-- Left Content -->
      <div>
        <p class="text-[#00A6CE] text-sm uppercase tracking-widest mb-4">
                        {% if subtitle %} 
 
                            {{ subtitle | raw }} 
 
                        {% else %} 
 
                            {{ "We've Exclusive Boats With Charter Offers" | raw }} 
 
                        {% endif %}
                    </p>
        
                            {% set title_tag = title_tag ?: 'P' %}
                            {{ ('<' ~ title_tag ~ ' class="text-white text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-8" >' ~ (title ? title : 'LET'S PLAN YOUR NEXT TOUR!') ~ ('PC8=' | base64_decode) ~ title_tag ~ '>') | raw }}
                        
        
        <div class="space-y-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-[#00A6CE] flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            </div>
            <div>
              <p class="text-gray-400 text-sm">Call Us Today</p>
              <p class="text-white font-semibold">
                        {% if phone %} 
 
                            {{ phone | raw }} 
 
                        {% else %} 
 
                            {{ "+1 715 302 8549" | raw }} 
 
                        {% endif %}
                    </p>
            </div>
          </div>
          
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-[#00A6CE] flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </div>
            <div>
              <p class="text-gray-400 text-sm">Email</p>
              <p class="text-white font-semibold">
                        {% if email %} 
 
                            {{ email | raw }} 
 
                        {% else %} 
 
                            {{ "support@my-domain.com" | raw }} 
 
                        {% endif %}
                    </p>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Right: Video Play Button -->
      <div class="flex justify-center lg:justify-end">
        <a href="{{ videolink }}" class="cta-banner-video__play-btn group relative"><div class="w-32 h-32 md:w-40 md:h-40 rounded-full border-4 border-white/30 flex items-center justify-center group-hover:border-[#00A6CE] transition-colors">
            <div class="w-20 h-20 md:w-24 md:h-24 rounded-full bg-white flex items-center justify-center group-hover:bg-[#00A6CE] transition-colors">
              <svg class="w-8 h-8 text-[#0a1628] group-hover:text-white transition-colors ml-1" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"></path></svg>
            </div>
          </div>
          <span class="absolute -bottom-8 left-1/2 -translate-x-1/2 text-white text-sm whitespace-nowrap"><? echo @$videotext ? nl2br($videotext) : 'Watch A Tour';?></span>
        </a>
      </div>
    </div>
  </div>
</section>