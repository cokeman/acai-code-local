<section class="welcome-section">
  <div class="welcome-section__container">
    <div class="welcome-section__content">
      <div class="welcome-section__text">
        <div class="welcome-section__badge">
                        {% if badge %} 
 
                            {{ badge | raw }} 
 
                        {% else %} 
 
                            {{ "
          Welcome to MaxHotel
        " | raw }} 
 
                        {% endif %}
                    </div>
        
                            {% set title_tag = title_tag ?: 'P' %}
                            {{ ('<' ~ title_tag ~ ' >' ~ (title ? title : '
          The Ultimate Luxury Experience
        ') ~ ('PC8=' | base64_decode) ~ title_tag ~ '>') | raw }}
                        
        <p>
                        {% if description %} 
 
                            {% if description | isHTML %}
                                {{ description | raw }} 
 
                            {% else %}
                                {{ description | nl2br }} 
 
                            {% endif %}
                        {% else %} 
 
                            {{ "
          Welcome to MaxHotel, where luxury meets comfort and every detail is crafted to perfection. Our world-class hotel offers an unparalleled experience with exceptional service, elegant accommodations, and premium amenities that will make your stay truly memorable.
        " | nl2br }} 
 
                        {% endif %}
                    </p>
        <div class="welcome-section__features">
          <div class="welcome-section__feature">
                        {% if feature1 %} 
 
                            {{ feature1 | raw }} 
 
                        {% else %} 
 
                            {{ "
            <div class="\&quot;welcome-section__feature-icon\&quot;">ICON</div>
            <div class="\&quot;welcome-section__feature-text\&quot;">
              <h4>Award Winning Service</h4>
              <p>Recognized for excellence in hospitality</p>
            </div>
          " | raw }} 
 
                        {% endif %}
                    </div>
          <div class="welcome-section__feature">
                        {% if feature2 %} 
 
                            {{ feature2 | raw }} 
 
                        {% else %} 
 
                            {{ "
            <div class="\&quot;welcome-section__feature-icon\&quot;">ICON</div>
            <div class="\&quot;welcome-section__feature-text\&quot;">
              <h4>Luxury Amenities</h4>
              <p>Premium facilities for your comfort</p>
            </div>
          " | raw }} 
 
                        {% endif %}
                    </div>
          <div class="welcome-section__feature">
                        {% if feature3 %} 
 
                            {{ feature3 | raw }} 
 
                        {% else %} 
 
                            {{ "
            <div class="\&quot;welcome-section__feature-icon\&quot;">ICON</div>
            <div class="\&quot;welcome-section__feature-text\&quot;">
              <h4>Prime Location</h4>
              <p>Located in the heart of the city</p>
            </div>
          " | raw }} 
 
                        {% endif %}
                    </div>
        </div>
        <a href="{{ button }}" class="welcome-section__btn">{{ button_anchor }}</a>
      </div>
      <div class="welcome-section__image">
        <img src="{{ image.0.urlPath | imagec(800) }}" alt="Hotel lobby elegant interior">
      </div>
    </div>
  </div>
</section>