<div class="p-2 lg:p-6 absolute top-0 w-full h-screen overflow-hidden pointer-events-none -z-1">
    <div class="container sm:mx-auto px-4 flex items-center justify-between flex-wrap relative">
        <img class="circle_menu" src="/template/estandar/images/fondo_banner.png">
    </div>
</div>
<nav class="navbar-wrapper p-2 lg:p-6 fixed top-0 w-full z-50 transition3s">
    <style>
        body {
            opacity: 0;
            /*transition: all 0.4s ease-in-out;*/
        }
    </style>
    <div v-for="tienda in configuracion_tienda"></div>
    <div class="container sm:mx-auto px-4 flex items-center justify-between flex-wrap relative">
        <div class="flex items-center flex-shrink-0 text-gray-900 mr-6">
            <a href="/" aria-label="Inicio">
                aa
                
{% if tienda.logo %}
<img src="{{ tienda.logo.0.urlPath | imagec(270) }}" alt="{{ configuracionRecord.titulo_de_pagina }}" class="h-8 lg:h-12">
{% endif %}

                
{% if !tienda.logo %}
<img src="{{ '/template/estandar/images/logo.png' | imagec(270) }}" alt="{{ configuracionRecord.titulo_de_pagina }}" class="h-8 lg:h-12">
{% endif %}

            </a>
        </div>
        <div class="block lg:hidden" onclick="document.querySelector('.navbar').classList.toggle('hidden')">
            <button class="flex items-center px-3 py-2  rounded text-gray-900 ">
                <svg class="fill-current h-6 w-6" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                    <title>Menu</title>
                    <path d="M0 3h20v2H0V3zm0 6h20v2H0V9zm0 6h20v2H0v-2z"></path>
                </svg>
            </button>
        </div>
        <div class="navbar w-full block flex-grow lg:flex lg:items-center hidden lg:w-auto lg:block">
            <ul class="text-xl lg:text-sm lg:flex-grow lg:text-right  lg:pb-4  text-white pt-4 px-0 ">{% set tw_apartados = menu(0,{'aClass':' py-0 lg:py-4 block','liClass':'lg:mb-0 mb-6 cursor-pointer block hover:scale-110 transition duration-200 transform lg:inline-block font-semibold hover:text-main-color mx-0 lg:mx-4 relative uppercase lg:my-0 my-4','submenuUlClass':'block lg:absolute left-0 bg-white p-2 text-sm text-black text-left rounded shadow-lg w-full lg:w-64 hidden','submenuLiClass':'p-2 hover:text-main-color'}) %}</ul>
            <ul v-hidden="true" v-for="cita in apartados" v-where="enlace like '%cita-previa%' " v-limit="1">
                <li class="hover:scale-110 transition duration-200 transform text-xl lg:text-sm cursor-pointer block lg:inline-block font-semibold hover:text-main-color mx-0 lg:my-0 my-4 lg:mx-4 relative uppercase">
                    <a href="{{cita.enlace}}" class="hidden bg-white lg:text-black text-blue-700 rounded-lg w-full block font-semibold py-0 lg:py-2 lg:px-4">{{'Hablemos' | translate}}</a>
                </li>
            </ul>
        </div>
    </div>
</nav>